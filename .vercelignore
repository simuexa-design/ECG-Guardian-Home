# Vercel Deployment Exclusion List
# Keeps the Serverless Function bundle ultra-lightweight (< 20 MB)

# Document deliverables & large assets (preserved on GitHub)
*.pdf
*.pptx
*.bat
build_pdf_*.py
build_ppt_*.py
capture_*.py
train_*.py
test_*.py

# Git & GitHub metadata
.git
.github

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Heavy training datasets & raw benchmarks
ptbxl_data/
models_saved/
tests/

# Keep only the production ONNX model in backend/trained_models/
backend/trained_models/*.pt
