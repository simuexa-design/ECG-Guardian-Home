# Vercel Deployment Exclusion List
# Keeps the Serverless Function bundle ultra-lightweight (< 290 MB)

# Document deliverables (preserved on GitHub)
*.pdf
*.pptx

# Local batch & execution scripts
*.bat
.git
.github

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Heavy training datasets & raw benchmarks
ptbxl_data/
models_saved/
sample_files/
tests/

# Keep only the production ONNX model in backend/trained_models/
backend/trained_models/*.pt
